{
  "name": "langy-reader",
  "version": "0.1.0",
  "description": "A self-hosted EPUB and PDF reader with local language help.",
  "scripts": {
    "test": "node --test",
    "build": "vite build",
    "build:thesaurus": "node scripts/build-thesaurus.js && node scripts/build-wiktionary.js",
    "start": "node server/index.js"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "epubjs": "0.3.93",
    "express": "5.3.0",
    "fast-xml-parser": "5.12.1",
    "franc-min": "6.2.0",
    "jszip": "3.10.1",
    "lucide": "1.73.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.5.438",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
