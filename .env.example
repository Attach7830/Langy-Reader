READER_BIND=0.0.0.0
READER_PORT=8088
READER_MODEL=qwen3:4b-instruct-2507-q4_K_M
READER_USER=reader
# Initial administrator. Existing libraries and preferences stay with this account.
# Create additional private accounts in Settings > Account after setting a password.
# Single-quote a value containing $ so Docker Compose preserves it literally.
READER_PASSWORD=
# Changing these initial credentials explicitly also recovers the administrator.
# An in-app password change survives restarts when these values stay unchanged.
# Optional separate device-sync credentials for the initial administrator only;
# blank values use that account's current login. Other users use their own login.
READER_SYNC_USER=
READER_SYNC_PASSWORD=
READER_KOKORO_URL=
READER_KOKORO_VOICE=ef_dora
# Local multilingual audio recognition model, downloaded during the language build.
# small improves Mandarin recognition; medium/large-v3 need more RAM and CPU time.
READER_WHISPER_MODEL=small
# Optional separate PaddleOCR service (compose.ocr.yaml). Set a private key when
# exposing its port beyond the Docker host, then save that key in Langy Settings.
LANGY_OCR_API_KEY=
LANGY_OCR_BIND=127.0.0.1
LANGY_OCR_PORT=8093
# Free web search for Discover books. The bundled search service has no public port.
# Point this at an existing SearXNG base URL if preferred (JSON format required).
READER_SEARCH_URL=http://search:8080
# Optional migrated storage. Use scripts/migrate-storage.sh to copy existing data
# and set both values; leaving them unset uses the normal Docker library volume.
# READER_DATA_SOURCE=/srv/langy/library
# READER_STORAGE_ID=<identifier written by the migration script>
